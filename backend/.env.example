# Copy to .env and fill in. Never commit .env.
# Use a development database here, never production.

# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_SECRET="generate-with: openssl rand -hex 32"

# Where the client runs (email links, Google sign-in redirect)
CLIENT_URL="http://localhost:5173"

# Email via Resend (optional locally: without a key, emails are skipped)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@your-verified-domain.com"

# End-of-day attendance trigger (required in production; see README)
CRON_SECRET=""

# Google sign-in (optional: the button hides itself when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# PORT=3000
